lbp-decomp change C1 for GCC 4.0.4 (after the pspdev patch, lbp-allegrex-tuning.diff, lbp-ins-from-zero-4.0.4.diff
and lbp-allegrex-xfer-4.0.4.diff): applies with `patch -p1` in gcc-4.0.4/. Two parts, both modelling what the
retail compiler demonstrably did (docs/TOOLCHAIN.md, Findings log 2026-11-09):
- block-copy loop order (config/mips/mips.c, mips_block_move_loop): for word-aligned copies, store the first word,
  advance both pointers, then store the rest at -12/-8/-4 from the new destination pointer. Retail EBOOT has 295 such
  loops in 186 functions and none in GCC 4.0.4's order (stores first, then the increments).
- one-instruction asm in delay slots: define_asm_attributes no longer forces can_delay "no" (mips.md), reorg's
  stop_search_p lets a one-instruction asm with operands move (reorg.c), and an asm is volatile only when written
  volatile (c-typeck.c, cp/semantics.c, stmt.c), since reorg never moves a volatile insn. Retail fills delay slots
  with VFPU loads and vector operations (about 120 in branch-likely slots, which the assembler never fills).
Adopted 2026-11-09 (owner decision via the coordinator) as build psp-gcc-4.0.4c, the gcc404x*/gcc404xs* profiles.
--- a/gcc/config/mips/mips.c
+++ b/gcc/config/mips/mips.c
@@ -3009,12 +3009,36 @@
   label = gen_label_rtx ();
   emit_label (label);
 
-  /* Emit the loop body.  */
-  mips_block_move_straight (dest, src, MAX_MOVE_BYTES);
+  /* Emit the loop body.  LBP experiment: for word-aligned copies, store the
+     first word, advance both pointers, then store the rest at negative
+     offsets from the new destination pointer (the retail order).  */
+  if (MEM_ALIGN (src) >= BITS_PER_WORD && MEM_ALIGN (dest) >= BITS_PER_WORD)
+    {
+      rtx regs[MAX_MOVE_REGS];
+      int i;
 
-  /* Move on to the next block.  */
-  emit_move_insn (src_reg, plus_constant (src_reg, MAX_MOVE_BYTES));
-  emit_move_insn (dest_reg, plus_constant (dest_reg, MAX_MOVE_BYTES));
+      for (i = 0; i < MAX_MOVE_REGS; i++)
+	{
+	  regs[i] = gen_reg_rtx (word_mode);
+	  emit_move_insn (regs[i], adjust_address (src, word_mode,
+						   i * UNITS_PER_WORD));
+	}
+      emit_move_insn (adjust_address (dest, word_mode, 0), regs[0]);
+      emit_move_insn (src_reg, plus_constant (src_reg, MAX_MOVE_BYTES));
+      emit_move_insn (dest_reg, plus_constant (dest_reg, MAX_MOVE_BYTES));
+      for (i = 1; i < MAX_MOVE_REGS; i++)
+	emit_move_insn (adjust_address (dest, word_mode,
+					i * UNITS_PER_WORD - MAX_MOVE_BYTES),
+			regs[i]);
+    }
+  else
+    {
+      mips_block_move_straight (dest, src, MAX_MOVE_BYTES);
+
+      /* Move on to the next block.  */
+      emit_move_insn (src_reg, plus_constant (src_reg, MAX_MOVE_BYTES));
+      emit_move_insn (dest_reg, plus_constant (dest_reg, MAX_MOVE_BYTES));
+    }
 
   /* Emit the loop condition.  */
   if (Pmode == DImode)
